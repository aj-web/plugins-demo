{
  "name": "plugins-demo",
  "version": "1.1.1",
  "description": "插件框架",
  "main": "dist-electron/main.js",
  "author": "优矩互动",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "electron .",
    "start": "electron .",
    "dev:electron": "vite build && electron .",
    "start:electron": "node start-electron.js",
    "dev:start": "node dev-start.js",
    "clean": "rimraf dist dist-electron",
    "build-win": "npm run clean && npm run build && electron-builder --win",
    "build-mac": "npm run clean && npm run build && electron-builder --mac",
    "build-linux": "npm run clean && npm run build && electron-builder --linux",
    "build-all": "npm run clean && npm run build && electron-builder -mwl",
    "dist": "npm run clean && npm run build && electron-builder --publish=never"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.15.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-tsc": "^1.8.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node-cron": "^3.0.11",
    "archiver": "^6.0.1",
    "element-plus": "^2.4.0",
    "extract-zip": "^2.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "pinia": "^2.1.0",
    "sharp": "^0.34.3",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.example.plugins-demo",
    "productName": "优创客户端体验版",
    "icon": "assets/icon.ico",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "config.json",
      "utils/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "ffprobe.exe",
        "to": "ffprobe.exe"
      },
      {
        "from": "chromium-1181",
        "to": "chromium-1181"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win64.${ext}",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "优创客户端体验版",
      "menuCategory": "优创客户端",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://npmmirror.com/mirrors/nsis/"
      }
    ],
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true
  }
}
