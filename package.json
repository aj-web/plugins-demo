{
  "name": "plugins-demo",
  "version": "0.2.0",
  "description": "插件框架",
  "main": "main.js",
  "author": "优矩互动",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "clean": "rimraf dist",
    "build": "npm run clean && electron-builder",
    "build-win": "npm run clean && electron-builder --win",
    "build-mac": "npm run clean && electron-builder --mac",
    "build-linux": "npm run clean && electron-builder --linux",
    "build-all": "npm run clean && electron-builder -mwl",
    "dist": "npm run clean && electron-builder --publish=never"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "fluent-ffmpeg": "^2.1.3"
  },
  "build": {
    "appId": "com.example.plugins-demo",
    "productName": "优创客户端体验版",
    "icon": "assets/icon.ico",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "config.json",
      "main.js",
      "ipcHandlers.js",
      "preload.js",
      "index.html",
      "load_plugins.js",
      "tracker_util.js",
      "utils/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-win64.${ext}",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "优创客户端体验版",
      "menuCategory": "优创客户端",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://npmmirror.com/mirrors/nsis/"
      }
    ],
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true
  }
}
